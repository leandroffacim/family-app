From a3fb41a8884d9022cb29de346350f7e86b41e91b Mon Sep 17 00:00:00 2001
From: Leandro <leandro@family-app.local>
Date: Tue, 25 Aug 2026 23:15:12 +0000
Subject: [PATCH] fix: ReferenceError global is not defined
 (amazon-cognito-identity-js)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

amazon-cognito-identity-js usa crypto-js por baixo, que espera o
'global' do Node — o Vite não faz esse polyfill sozinho (diferente
do webpack, que fazia por padrão). Resolvido com
define: { global: 'globalThis' } no vite.config.ts.
---
 frontend/vite.config.ts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/frontend/vite.config.ts b/frontend/vite.config.ts
index 8a24cd2..17dc17c 100644
--- a/frontend/vite.config.ts
+++ b/frontend/vite.config.ts
@@ -4,4 +4,11 @@ import tailwindcss from "@tailwindcss/vite";
 
 export default defineConfig({
   plugins: [tailwindcss(), react()],
+  // amazon-cognito-identity-js (via crypto-js) espera o `global` do
+  // Node, que não existe no navegador — o Vite não faz esse polyfill
+  // sozinho (diferente do webpack). Sem isso dá
+  // "Uncaught ReferenceError: global is not defined".
+  define: {
+    global: "globalThis",
+  },
 });
-- 
2.43.0

